---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, type Lang } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.webp", Astro.site);

// Build one <link rel="alternate" hreflang="..."> per locale, plus an
// x-default, so search engines can discover and correctly attribute the
// /es/ and /it/ pages instead of only ever indexing one language.
const localeAlternates = Object.keys(languages) as Lang[];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates for the localized routes -->
    {
      localeAlternates.map((l) => (
        <link
          rel="alternate"
          hreflang={l === "en" ? "en-US" : l}
          href={new URL(getRelativeLocaleUrl(l, ""), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getRelativeLocaleUrl("en", ""), Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Preload hero image -->
    <link rel="preload" href="/og-image.webp" as="image" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org/",
      "@type": "Person",
      name: "Pablo Nicolas Heidenreich",
      jobTitle: "Senior Frontend & Full-Stack Engineer",
      url: Astro.site,
      image: ogImageURL.toString(),
      sameAs: [
        "https://github.com/heidenreich20",
        "https://www.linkedin.com/in/pablo-heidenreich/",
      ],
      knowsLanguage: ["English", "Spanish", "Italian"],
      knowsAbout: [
        "Frontend Development",
        "Full-Stack Development",
        "TypeScript",
        "Node.js",
        "React Native",
        "Next.js",
        "Astro",
      ],
      homeLocation: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressLocality: "San Martin",
          addressRegion: "Buenos Aires",
          addressCountry: "AR",
        },
      },
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>

---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="mb-8 pt-8 border-t border-divider">
  <div class="flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="text-left space-y-2">
      <p class="font-mono text-xs text-muted">Portfolio · 2026</p>
      <p class="text-sm md:text-base text-text/70">
        © {t("Footer.Built with")}{" "}
        <a
          class="text-primary hover:text-secondary underline underline-offset-2"
          href="https://astro.build/"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >{" "}
        {t("Footer.And")}{" "}
        <a
          class="text-primary hover:text-secondary underline underline-offset-2"
          href="https://tailwindcss.com/"
          target="_blank"
          rel="noopener noreferrer">Tailwind</a
        >
      </p>
    </div>
    <div class="text-center md:text-right">
      <p class="font-fraunces italic text-sm text-text/70">
        {t("Footer.part1")}{" "}
        <a
          class="text-text hover:text-primary underline underline-offset-2"
          href="https://www.linkedin.com/in/pablo-heidenreich/"
          target="_blank"
          rel="noopener noreferrer">Pablo Heidenreich</a
        >
      </p>
    </div>
  </div>
  <div class="mt-8 pt-4 border-t border-divider flex justify-between items-center text-[10px] font-mono text-muted">
    <span>v3.0.0-astro</span>
    <span class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 bg-secondary rounded-full animate-pulse"></span>
      system_online
    </span>
  </div>
</footer>

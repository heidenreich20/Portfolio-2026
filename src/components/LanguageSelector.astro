---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const currentPath = Astro.url.pathname.replace(/^\/(es|it)/, "") || "/";

const flags: Record<Lang, string> = {
  es: `<svg width="20" height="14" viewBox="0 0 30 20" class="border border-divider"><path d="M30 0H0v20h30V0z" fill="#FFDA44"/><path d="M30 0H0v6.6h30V0zM30 13.3H0V20h30v-6.7z" fill="#D80027"/></svg>`,
  en: `<svg width="20" height="14" viewBox="0 0 30 20" class="border border-divider"><path d="M30 0H0v20h30V0z" fill="#F0F0F0"/><path d="M16.8 0h-3.7v8.1H0v3.7h13.1V20h3.7v-8.1H30V8.1h-13.2V0z" fill="#D80027"/></svg>`,
  it: `<svg width="20" height="14" viewBox="0 0 30 20" class="border border-divider"><path d="M10 0H0v20h10V0z" fill="#6DA544"/><path d="M20 0H10v20h10V0z" fill="#F0F0F0"/><path d="M30 0H20v20h10V0z" fill="#D80027"/></svg>`,
};

const localeList = Object.keys(languages) as Lang[];
const labelFor = (l: Lang) => l.toUpperCase();
---

<div class="language-selector relative w-28">
  <button
    type="button"
    class="lang-toggle w-full flex items-center justify-between border border-divider px-3 py-2 hover:border-primary transition-colors"
    aria-expanded="false"
  >
    <div class="flex items-center gap-2">
      <Fragment set:html={flags[lang]} />
      <span class="font-mono text-xs text-text">{labelFor(lang)}</span>
    </div>
    <span class="lang-arrow text-[10px] text-text/50 transition-transform duration-300">▼</span>
  </button>
  <ul class="lang-list absolute z-60 mt-2 w-full bg-bg border border-divider shadow-[0_4px_12px_rgba(31,43,58,0.1)] hidden">
    {
      localeList.map((l) => (
        <li>
          <a
            href={getRelativeLocaleUrl(l, currentPath)}
            class="w-full flex items-center gap-3 p-3 text-text/80 hover:text-primary font-mono text-xs transition-colors border-b border-divider last:border-b-0"
          >
            <Fragment set:html={flags[l]} />
            {labelFor(l)}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLDivElement>(".language-selector").forEach((selector) => {
    const toggle = selector.querySelector<HTMLButtonElement>(".lang-toggle")!;
    const list = selector.querySelector<HTMLUListElement>(".lang-list")!;
    const arrow = selector.querySelector<HTMLSpanElement>(".lang-arrow")!;

    toggle.addEventListener("click", () => {
      const isOpen = !list.classList.contains("hidden");
      list.classList.toggle("hidden");
      arrow.classList.toggle("rotate-180");
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });

    document.addEventListener("click", (e) => {
      if (!selector.contains(e.target as Node)) {
        list.classList.add("hidden");
        arrow.classList.remove("rotate-180");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>

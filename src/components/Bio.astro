---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="relative flex mt-12">
  <section class="flex flex-col gap-12 my-12 leading-8 w-full sm:w-1/2 justify-end">
    <div class="xl:text-6xl text-text lg:text-3xl text-lg font-semibold font-fraunces leading-tight">
      <h1>{t("Title.part1")}</h1>
      <p>{t("Title.part2")}</p>
    </div>
    <p class="xl:text-lg text-xs text-text/70 max-w-md">
      {t("Title.description")}
    </p>
    <div class="flex xl:flex-row flex-col gap-6 items-center justify-start">
      <ul class="flex gap-5">
        <li>
          <a
            class="block text-text/60 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-sm transition-colors"
            href="https://www.instagram.com/revicmanne/"
            aria-label="Visit my Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 50 50" fill="currentColor" class="h-8 w-8">
              <path d="M16,3c-7.17,0 -13,5.83 -13,13v18c0,7.17 5.83,13 13,13h18c7.17,0 13,-5.83 13,-13v-18c0,-7.17 -5.83,-13 -13,-13zM37,11c1.1,0 2,0.9 2,2c0,1.1 -0.9,2 -2,2c-1.1,0 -2,-0.9 -2,-2c0,-1.1 0.9,-2 2,-2zM25,14c6.07,0 11,4.93 11,11c0,6.07 -4.93,11 -11,11c-6.07,0 -11,-4.93 -11,-11c0,-6.07 4.93,-11 11,-11zM25,16c-4.96,0 -9,4.04 -9,9c0,4.96 4.04,9 9,9c4.96,0 9,-4.04 9,-9c0,-4.96 -4.04,-9 -9,-9z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            class="block text-text/60 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-sm transition-colors"
            href="https://www.linkedin.com/in/pablo-heidenreich/"
            aria-label="Visit my Linkedin"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 50 50" fill="currentColor" class="h-8 w-8">
              <path d="M41,4h-32c-2.76,0 -5,2.24 -5,5v32c0,2.76 2.24,5 5,5h32c2.76,0 5,-2.24 5,-5v-32c0,-2.76 -2.24,-5 -5,-5zM17,20v19h-6v-19zM11,14.47c0,-1.4 1.2,-2.47 3,-2.47c1.8,0 2.93,1.07 3,2.47c0,1.4 -1.12,2.53 -3,2.53c-1.8,0 -3,-1.13 -3,-2.53zM39,39h-6c0,0 0,-9.26 0,-10c0,-2 -1,-4 -3.5,-4.04h-0.08c-2.42,0 -3.42,2.06 -3.42,4.04c0,0.91 0,10 0,10h-6v-19h6v2.56c0,0 1.93,-2.56 5.81,-2.56c3.97,0 7.19,2.73 7.19,8.26z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            class="block text-text/60 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-sm transition-colors"
            href="https://github.com/heidenreich20"
            aria-label="Visit my Github"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 50 50" fill="currentColor" class="h-8 w-8">
              <path d="M17.791,46.836c0.711,-0.306 1.209,-1.013 1.209,-1.836v-5.4c0,-0.197 0.016,-0.402 0.041,-0.61c-0.014,0.004 -0.027,0.007 -0.041,0.01c0,0 -3,0 -3.6,0c-1.5,0 -2.8,-0.6 -3.4,-1.8c-0.7,-1.3 -1,-3.5 -2.8,-4.7c-0.3,-0.2 -0.1,-0.5 0.5,-0.5c0.6,0.1 1.9,0.9 2.7,2c0.9,1.1 1.8,2 3.4,2c2.487,0 3.82,-0.125 4.622,-0.555c0.934,-1.389 2.227,-2.445 3.578,-2.445v-0.025c-5.668,-0.182 -9.289,-2.066 -10.975,-4.975c-3.665,0.042 -6.856,0.405 -8.677,0.707c-0.058,-0.327 -0.108,-0.656 -0.151,-0.987c1.797,-0.296 4.843,-0.647 8.345,-0.714c-0.112,-0.276 -0.209,-0.559 -0.291,-0.849c-3.511,-0.178 -6.541,-0.039 -8.187,0.097c-0.02,-0.332 -0.047,-0.663 -0.051,-0.999c1.649,-0.135 4.597,-0.27 8.018,-0.111c-0.079,-0.5 -0.13,-1.011 -0.13,-1.543c0,-1.7 0.6,-3.5 1.7,-5c-0.5,-1.7 -1.2,-5.3 0.2,-6.6c2.7,0 4.6,1.3 5.5,2.1c1.699,-0.701 3.599,-1.101 5.699,-1.101c2.1,0 4,0.4 5.6,1.1c0.9,-0.8 2.8,-2.1 5.5,-2.1c1.5,1.4 0.7,5 0.2,6.6c1.1,1.5 1.7,3.2 1.6,5c0,0.484 -0.045,0.951 -0.11,1.409c3.499,-0.172 6.527,-0.034 8.204,0.102c-0.002,0.337 -0.033,0.666 -0.051,0.999c-1.671,-0.138 -4.775,-0.28 -8.359,-0.089c-0.089,0.336 -0.197,0.663 -0.325,0.98c3.546,0.046 6.665,0.389 8.548,0.689c-0.043,0.332 -0.093,0.661 -0.151,0.987c-1.912,-0.306 -5.171,-0.664 -8.879,-0.682c-1.665,2.878 -5.22,4.755 -10.777,4.974v0.031c2.6,0 5,3.9 5,6.6v5.4c0,0.823 0.498,1.53 1.209,1.836c9.161,-3.032 15.791,-11.672 15.791,-21.836c0,-12.682 -10.317,-23 -23,-23c-12.683,0 -23,10.318 -23,23c0,10.164 6.63,18.804 15.791,21.836z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
      <a
        href="#contactMe"
        class="bg-primary text-bg hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors xl:text-base text-sm font-medium px-8 py-3"
        >{t("Contact")}</a
      >
    </div>
  </section>

  <div class="hidden sm:block sm:w-1/2 relative overflow-hidden" aria-hidden="true">
    <span
      class="absolute inset-0 flex items-center justify-center font-fraunces italic text-[260px] xl:text-[320px] leading-none text-primary/10 select-none pointer-events-none"
    >
      PH
    </span>
    <div class="absolute inset-0 flex flex-col justify-evenly pointer-events-none">
      <div class="border-t border-divider"></div>
      <div class="border-t border-divider"></div>
      <div class="border-t border-divider"></div>
      <div class="border-t border-divider"></div>
      <div class="border-t border-divider"></div>
    </div>
  </div>
</div>

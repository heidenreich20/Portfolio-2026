# EmailJS credentials for the contact form.
# IMPORTANT: Astro/Vite only expose env vars to client-side code when they
# are prefixed with PUBLIC_ — that's why these are renamed from the old
# VITE_SERVICE_ID / VITE_TEMPLATE_ID / VITE_PUBLIC_KEY.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
